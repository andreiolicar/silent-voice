# Server only. Never prefix secrets with VITE_. Copy to .env locally.
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Production: comma-separated exact HTTPS origins; never use a wildcard.
ADDITIONAL_APP_ORIGINS=
# Legacy SQLite backup/import tooling only; not used by the running API.
SQLITE_PATH=data/silent-voice.sqlite
# Legacy secret retained only during rollback compatibility.
SESSION_SECRET=
# Authentication server only. Never expose these through VITE_ or EXPO_PUBLIC_.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:5173
RESEND_API_KEY=
# Use a sender on the exact domain verified in your Resend account.
AUTH_EMAIL_FROM=Silent Voice <conta@silentvoice.com.br>
