{
  "name": "@silent-voice/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "generate:intro": "node scripts/generate-intro-logo.mjs",
    "generate:chat": "tsx scripts/generate-chat-ui.ts",
    "prebuild": "npm run generate:intro && npm run generate:chat",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "lucide-react": "1.57.0",
    "motion": "13.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "@silent-voice/contracts": "0.0.0",
    "@silent-voice/web-ui": "0.0.0",
    "@silent-voice/http-client": "0.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.4",
    "motion-dom": "13.5.0"
  }
}
