{
  "name": "@silent-voice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "admin:create": "node --env-file-if-exists=.env --experimental-strip-types src/scripts/create-admin.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/db/migrate.ts",
    "db:backup": "node --env-file-if-exists=.env --experimental-strip-types src/scripts/backup.ts",
    "db:import:sqlite": "node --env-file-if-exists=.env --experimental-strip-types src/scripts/import-sqlite.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "better-auth": "1.7.14",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "resend": "6.35.0",
    "zod": "4.6.7",
    "@openuidev/lang-core": "1.0.1",
    "@silent-voice/contracts": "0.0.0",
    "@better-auth/core": "1.7.14",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "better-call": "1.4.4",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "nanostores": "1.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
