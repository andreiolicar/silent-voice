{
  "name": "silent-voice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:intro": "node scripts/generate-intro-logo.mjs",
    "prebuild": "npm run generate:intro && npm run generate:chat",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:ui": "vitest run",
    "generate:chat": "tsx scripts/generate-chat-ui.ts",
    "dev:api": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "admin:create": "node --env-file-if-exists=.env --experimental-strip-types server/scripts/create-admin.ts",
    "db:backup": "node --env-file-if-exists=.env --experimental-strip-types server/scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@mistralai/mistralai": "^2.7.0",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "lucide-react": "^1.57.0",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
